<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../layouts/css_link') %>
</head>

<body
    class="layout-fixed fixed-header fixed-footer sidebar-expand-lg sidebar-open sidebar-mini app-loaded bg-body-tertiary">
    <div class="app-wrapper">
        <%- include('../layouts/header') %>
            <%- include('../layouts/sidebar') %>
                <main class="app-main">
                    <div class="app-content-header">
                        <!--begin::Container-->
                        <div class="container-fluid">
                            <!--begin::Row-->
                            <div class="row align-items-center mb-3">
                                <div class="col-sm-12">
                                    <h3 class="mb-0">
                                        <%= typeof title !=='undefined' ? title : 'Dashboard' %>
                                    </h3>
                                </div>
                            </div>
                            <!--end::Row-->

                            <!-- Filter Row -->
                            <div class="row mb-2">
                                <div class="col-12">
                                    <div class="card shadow-sm border-0">
                                        <div
                                            class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white rounded">
                                            <div class="d-flex align-items-center gap-2">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                    fill="currentColor" class="bi bi-funnel-fill text-muted"
                                                    viewBox="0 0 16 16">
                                                    <path
                                                        d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5v-2z" />
                                                </svg>
                                                <span class="fw-bold text-secondary">Filters:</span>
                                            </div>
                                            <div
                                                class="d-flex flex-wrap gap-3 align-items-center flex-grow-1 justify-content-end">
                                                <div class="input-group input-group-sm w-auto shadow-sm">
                                                    <span
                                                        class="input-group-text bg-light fw-bold text-muted border-end-0">Course</span>
                                                    <select name="course_id" id="course_id"
                                                        class="form-select border-start-0" onchange="applyFilters()">
                                                        <option value="">All Courses</option>
                                                        <% if (typeof courses !=='undefined' ) { %>
                                                            <% courses.forEach(c=> { %>
                                                                <option value="<%= c.id %>"
                                                                    <%=String(c.id)===String(filters.course_id)
                                                                    ? 'selected' : '' %>><%= c.name %>
                                                                </option>
                                                                <% }) %>
                                                                    <% } %>
                                                    </select>
                                                </div>

                                                <div class="input-group input-group-sm w-auto shadow-sm">
                                                    <span
                                                        class="input-group-text bg-light fw-bold text-muted border-end-0">Semester</span>
                                                    <select name="semester_id" id="semester_id"
                                                        class="form-select border-start-0" onchange="applyFilters()">
                                                        <option value="">All Semesters</option>
                                                        <% if (typeof semesters !=='undefined' ) { %>
                                                            <% semesters.forEach(s=> { %>
                                                                <option value="<%= s.id %>"
                                                                    <%=String(s.id)===String(filters.semester_id)
                                                                    ? 'selected' : '' %>><%= s.name %>
                                                                </option>
                                                                <% }) %>
                                                                    <% } %>
                                                    </select>
                                                </div>

                                                <div class="input-group input-group-sm w-auto shadow-sm">
                                                    <span
                                                        class="input-group-text bg-light fw-bold text-muted border-end-0">Session</span>
                                                    <select name="academic_year_id" id="academic_year_id"
                                                        class="form-select border-start-0" onchange="applyFilters()">
                                                        <% academicYears.forEach(year=> { %>
                                                            <option value="<%= year.id %>"
                                                                <%=String(year.id)===String(activeYearId) ? 'selected'
                                                                : '' %>><%= year.session %>
                                                            </option>
                                                            <% }) %>
                                                    </select>
                                                </div>

                                                <% if (filters.course_id || filters.semester_id) { %>
                                                    <button type="button"
                                                        class="btn btn-sm btn-outline-danger shadow-sm fw-bold d-flex align-items-center gap-1"
                                                        onclick="clearFilters()"
                                                        title="Clear Course and Semester filters">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                            fill="currentColor" class="bi bi-x-circle-fill"
                                                            viewBox="0 0 16 16">
                                                            <path
                                                                d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z" />
                                                        </svg>
                                                        Clear
                                                    </button>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- End Filter Row -->

                        </div>
                        <!--end::Container-->
                    </div>
                    <!--end::App Content Header-->
                    <!--begin::App Content-->
                    <div class="app-content">
                        <!--begin::Container-->
                        <div class="container-fluid">
                            <!--begin::Row-->
                            <div class="row">
                                <!-- 🟡 User Registrations -->
                                <div class="col-lg-3 col-6">
                                    <div class="small-box text-bg-warning">
                                        <div class="inner">
                                            <h3>
                                                <%= typeof data !=='undefined' ? data.formFeeSuccessCount : 0 %>
                                            </h3>
                                            <p>Total Registered</p>
                                        </div>
                                        <svg class="small-box-icon" fill="currentColor" viewBox="0 0 24 24"
                                            xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path
                                                d="M6.25 6.375a4.125 4.125 0 118.25 0 4.125 4.125 0 01-8.25 0zM3.25 19.125a7.125 7.125 0 0114.25 0v.003l-.001.119a.75.75 0 01-.363.63 13.067 13.067 0 01-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 01-.364-.63l-.001-.122zM19.75 7.5a.75.75 0 00-1.5 0v2.25H16a.75.75 0 000 1.5h2.25v2.25a.75.75 0 001.5 0v-2.25H22a.75.75 0 000-1.5h-2.25V7.5z">
                                            </path>
                                        </svg>
                                    </div>
                                </div>

                                <!-- 🔵 Admitted Students -->
                                <div class="col-lg-3 col-6">
                                    <div class="small-box text-bg-primary">
                                        <div class="inner">
                                            <h3>
                                                <%= typeof data !=='undefined' ? data.admittedStudentCount : 0 %>
                                            </h3>
                                            <p>Admitted Students</p>
                                        </div>
                                        <svg class="small-box-icon" fill="currentColor" viewBox="0 0 24 24"
                                            xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                            <path
                                                d="M12 3L2 12h3v9h14v-9h3L12 3zm0 4.85L16.15 11H7.85L12 7.85zM7 19v-6.15L12 9.15l5 3.7V19H7z">
                                            </path>
                                        </svg>
                                    </div>
                                </div>

                                <!-- 💰 Total Form Fees Collected -->
                                <div class="col-lg-3 col-6">
                                    <div class="small-box text-bg-info text-white">
                                        <div class="inner">
                                            <h3>₹<%= typeof data !=='undefined' ?
                                                    Number(data.totalFormFee).toLocaleString('en-IN', {
                                                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0.00' %>
                                            </h3>
                                            <p>Total Form Fees Collected</p>
                                        </div>
                                        <svg class="small-box-icon text-white" fill="currentColor" viewBox="0 0 24 24"
                                            xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="opacity: 0.3;">
                                            <path
                                                d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 14H7v-2h10v2zm0-4H7v-2h10v2zm0-4H7V7h10v2z">
                                            </path>
                                        </svg>
                                    </div>
                                </div>

                                <!-- 💰 Total Admission Fees Collected -->
                                <div class="col-lg-3 col-6">
                                    <div class="small-box text-bg-secondary">
                                        <div class="inner">
                                            <h3>₹<%= typeof data !=='undefined' ?
                                                    Number(data.totalAdmissionFee).toLocaleString('en-IN', {
                                                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '0.00' %>
                                            </h3>
                                            <p>Total Admission Fees Collected</p>
                                        </div>
                                        <svg class="small-box-icon" fill="currentColor" viewBox="0 0 24 24"
                                            xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="opacity: 0.3;">
                                            <path
                                                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2H9.5a.5.5 0 01-.5-.5v-1a.5.5 0 01.5-.5H11v-1H9.5a.5.5 0 01-.5-.5v-1a.5.5 0 01.5-.5H11V8h2v1h1.5a.5.5 0 01.5.5v1a.5.5 0 01-.5.5H13v1h1.5a.5.5 0 01.5.5v1a.5.5 0 01-.5.5H13v2z">
                                            </path>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                            <!--end::Row-->

                            <!--begin::Report Table Row-->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="card shadow-sm border-0 rounded-3">
                                        <div class="card-header text-white"
                                            style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                                            <h5 class="mb-0 d-flex align-items-center">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                    fill="currentColor" class="bi bi-bar-chart-fill me-2"
                                                    viewBox="0 0 16 16">
                                                    <path
                                                        d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-3zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V2z" />
                                                </svg>
                                                Detailed Admission Report
                                            </h5>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table
                                                    class="table table-hover table-bordered table-striped align-middle mb-0 text-center">
                                                    <thead class="table-dark">
                                                        <tr>
                                                            <th scope="col" class="text-start ps-3">Class</th>
                                                            <th scope="col" class="text-start">Course</th>
                                                            <th scope="col">Semester / Year</th>
                                                            <th scope="col">Total Registered</th>
                                                            <th scope="col">Total Applied</th>
                                                            <th scope="col">Total Counselling</th>
                                                            <th scope="col">Total Admitted</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (typeof reportData !=='undefined' && reportData.length> 0)
                                                            { %>
                                                            <% let totalReg=0, totalApp=0, totalCoun=0, totalAdm=0;
                                                                reportData.forEach(row=> {
                                                                totalReg += parseInt(row.totalRegistered || 0);
                                                                totalApp += parseInt(row.totalApplied || 0);
                                                                totalCoun += parseInt(row.totalCounselling || 0);
                                                                totalAdm += parseInt(row.totalAdmitted || 0);
                                                                %>
                                                                <tr>
                                                                    <td class="text-start ps-3 fw-medium">
                                                                        <%= row.class %>
                                                                    </td>
                                                                    <td class="text-start">
                                                                        <%= row.courseName %>
                                                                    </td>
                                                                    <td><span class="badge bg-secondary">
                                                                            <%= row.semesterName %>
                                                                        </span></td>
                                                                    <td class="fw-bold text-dark">
                                                                        <%= row.totalRegistered %>
                                                                    </td>
                                                                    <td class="fw-bold text-info">
                                                                        <%= row.totalApplied %>
                                                                    </td>
                                                                    <td class="fw-bold text-primary">
                                                                        <%= row.totalCounselling %>
                                                                    </td>
                                                                    <td class="fw-bold text-success">
                                                                        <%= row.totalAdmitted %>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                                    <tr class="table-active fw-bold">
                                                                        <td colspan="3" class="text-end pe-3">GRAND
                                                                            TOTAL</td>
                                                                        <td class="text-dark">
                                                                            <%= totalReg %>
                                                                        </td>
                                                                        <td class="text-info">
                                                                            <%= totalApp %>
                                                                        </td>
                                                                        <td class="text-primary">
                                                                            <%= totalCoun %>
                                                                        </td>
                                                                        <td class="text-success">
                                                                            <%= totalAdm %>
                                                                        </td>
                                                                    </tr>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="7" class="text-muted py-4">No
                                                                                data available for the selected academic
                                                                                session.</td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--end::Report Table Row-->

                        </div>
                        <!--end::Container-->
                    </div>
                    <!--end::App Content-->
                </main>
                <%- include('../layouts/footer') %>
    </div>
    <%- include('../layouts/script_link') %>

        <!-- Hidden Form for POST Filters -->
        <form id="hiddenFilterForm" method="POST" action="/admin/dashboard" style="display: none;">
            <input type="hidden" name="course_id" id="hidden_course_id">
            <input type="hidden" name="semester_id" id="hidden_semester_id">
            <input type="hidden" name="academic_year_id" id="hidden_academic_year_id">
        </form>

        <!-- Inline script for full-page loader and clean URL params on filter change -->
        <script>
            function applyFilters() {
                // Show a simple full page loader
                const loader = document.createElement('div');
                loader.innerHTML = `
            <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(255, 255, 255, 0.7); z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 4rem; height: 4rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="text-primary fw-bold">Updating Dashboard...</h4>
            </div>
        `;
                document.body.appendChild(loader);

                document.getElementById('hidden_course_id').value = document.getElementById('course_id').value;
                document.getElementById('hidden_semester_id').value = document.getElementById('semester_id').value;
                document.getElementById('hidden_academic_year_id').value = document.getElementById('academic_year_id').value;
                document.getElementById('hiddenFilterForm').submit();
            }

            function clearFilters() {
                // Show a simple full page loader
                const loader = document.createElement('div');
                loader.innerHTML = `
            <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(255, 255, 255, 0.7); z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                <div class="spinner-border text-danger mb-3" role="status" style="width: 4rem; height: 4rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="text-danger fw-bold">Clearing Filters...</h4>
            </div>
        `;
                document.body.appendChild(loader);

                document.getElementById('hidden_course_id').value = '';
                document.getElementById('hidden_semester_id').value = '';
                document.getElementById('hidden_academic_year_id').value = document.getElementById('academic_year_id').value;
                document.getElementById('hiddenFilterForm').submit();
            }
        </script>
</body>
</html>